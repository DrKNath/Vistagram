{
  "name": "vistagram",
  "version": "1.0.0",
  "description": "Réseau social — projet SCRUM, IUT R&T Colmar.",
  "main": "index.js",
  "scripts": {
    "dev": "node --import tsx --watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node scripts/run-tests.mjs",
    "test:ui": "node scripts/run-tests.mjs --ui",
    "db:push": "node scripts/prepare-db.mjs && prisma db push && node --import tsx scripts/backfill-reports.ts",
    "db:studio": "prisma studio",
    "test:moderation": "node scripts/run-tests.mjs test/integration/moderation.test.ts test/integration/moderation.security.test.ts",
    "user:role": "node --import tsx scripts/set-role.ts",
    "push:moderation": "node scripts/push-moderation.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrKNath/Vistagram.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DrKNath/Vistagram/issues"
  },
  "homepage": "https://github.com/DrKNath/Vistagram#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true
  }
}
